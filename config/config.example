# hermes-code config - copy to ~/.config/hermes-code/config (KEY=value, sourced).
# Anything already in the environment wins over this file.

# Optional: route to a non-default Hermes profile via /p/<profile>/ .
# Needs that profile's own API_SERVER_KEY in the secrets file.
# HERMES_API_PROFILE=coder

# Approval for run / write_file / edit_file:  ask (default) | auto | never
# HERMES_CODE_APPROVE=ask

# Extra denied `run` commands: '|'-separated shell case-globs, e.g.
# HERMES_CODE_DENY=*terraform*apply*|*kubectl*delete*

# Tuning
# HERMES_CODE_MAX_ROUNDS=8
# HERMES_CODE_RUN_TIMEOUT=120
# HERMES_CODE_MAX_OUTPUT=20000
# HERMES_API_RUN_TIMEOUT=600
# HERMES_API_POLL_INTERVAL=2
