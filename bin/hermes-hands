#!/usr/bin/env bash
# hermes-hands - terminal chat with a central Hermes brain over its Runs API.
# Hermes holds the plan/memory; it drives a persistent local shell plus
# read_file / write_file / edit_file to see and act on the repo you're in.
#
#   hermes-hands                    interactive REPL, rooted at $PWD
#   hermes-hands "message"          one-shot
#   echo msg | hermes-hands -       one-shot from stdin
#   hermes-hands -c "message"       continue the latest session for this directory
#   hermes-hands --session <id> …   use a specific session
#   hermes-hands --new "message"    force a fresh session
#   hermes-hands --yolo …           skip approval prompts (run/write auto-approved)
#   hermes-hands check              preflight the API connection
#   hermes-hands sessions           list local sessions
#   hermes-hands setup              interactive first-run config
#   hermes-hands --version          print version
set -euo pipefail

# --- locate the checkout so share/ and lib/ resolve even via a symlink ---
_self="${BASH_SOURCE[0]}"
while [[ -L "$_self" ]]; do
  _t="$(readlink "$_self")"; case "$_t" in /*) _self="$_t" ;; *) _self="$(dirname "$_self")/$_t" ;; esac
done
HC_ROOT="$(cd "$(dirname "$_self")/.." && pwd)"
export HC_ROOT

. "$HC_ROOT/lib/util.sh"
. "$HC_ROOT/lib/session.sh"
. "$HC_ROOT/lib/api.sh"
. "$HC_ROOT/lib/dispatch.sh"
. "$HC_ROOT/lib/loop.sh"

usage() { sed -n '2,16{s/^# \{0,1\}//;s/^#$//;p;}' "$_self"; }

HC_VERSION="$( { cat "$HC_ROOT/VERSION" 2>/dev/null || echo '0.0.0-dev'; } | tr -d '[:space:]')"
hc_version() {
  local sha=""
  [[ -d "$HC_ROOT/.git" ]] && sha="$(git -C "$HC_ROOT" rev-parse --short HEAD 2>/dev/null || true)"
  printf 'hermes-hands %s%s\n' "$HC_VERSION" "${sha:+ ($sha)}"
}

# render a final answer: markdown-aware if a renderer is around and we're on a tty
hc_render() {
  if [[ -t 1 ]] && command -v glow >/dev/null 2>&1; then glow -w "${COLUMNS:-100}" -
  elif [[ -t 1 ]] && command -v bat  >/dev/null 2>&1; then bat -pp -l md --color=always
  else cat; fi
}

hc_setup() {
  local dir="${XDG_CONFIG_HOME:-$HOME/.config}/hermes-hands"
  mkdir -p "$dir"; chmod 700 "$dir"
  local url key
  read -r -p "Hermes API base URL (https://…): " url
  read -r -s -p "Hermes API_SERVER_KEY: " key; echo
  printf '# hermes-hands config\n# HERMES_API_PROFILE=coder   # optional /p/<profile>/ prefix\n# HERMES_HANDS_APPROVE=ask    # ask | auto | never\n' > "$dir/config"
  { printf '# hermes-hands secrets - chmod 600, do not commit\n'
    printf 'export HERMES_API_URL=%q\n' "$url"
    printf 'export HERMES_API_KEY=%q\n' "$key"; } > "$dir/secrets"
  chmod 600 "$dir/secrets"
  echo "wrote $dir/config and $dir/secrets"
  hc_load_config
  "$_self" check || true
  local line="[ -f \"\$HOME/.config/hermes-hands/secrets\" ] && . \"\$HOME/.config/hermes-hands/secrets\""
  if ! grep -qF "hermes-hands/secrets" "$HOME/.bashrc" 2>/dev/null; then
    read -r -p "Add the secrets-sourcing line to ~/.bashrc? [y/N] " a
    [[ "$a" == [yY] ]] && printf '\n# hermes-hands\n%s\n' "$line" >> "$HOME/.bashrc" && echo "added."
  fi
}

# --- arg parse ---
SMODE=new           # new | continue | <id>
ONESHOT=""
STDIN=0
while (( $# )); do
  case "$1" in
    -h|--help)         usage; exit 0 ;;
    -v|--version)      hc_version; exit 0 ;;
    version)           hc_version; exit 0 ;;
    check|--check)      hc_load_config; hc_api_check; exit $? ;;
    sessions|--list)    hc_session_list; exit 0 ;;
    setup)             hc_setup; exit 0 ;;
    -c|--continue)      SMODE=continue ;;
    --new)             SMODE=new ;;
    --session)         shift; SMODE="${1:?--session needs an id}" ;;
    --yolo)            export HERMES_HANDS_APPROVE=auto ;;
    -)                 STDIN=1 ;;
    --)                shift; ONESHOT="$*"; break ;;
    -*)                hc_die "unknown option: $1" ;;
    *)                 ONESHOT="${ONESHOT:+$ONESHOT }$1" ;;
  esac
  shift || true
done

hc_load_config
HC_REPO_ROOT="$(pwd -P)"; export HC_REPO_ROOT
trap 'hc_shell_stop 2>/dev/null || true' EXIT

run_turn() {   # $1 = message ; prints the answer
  local sfile; sfile="$(hc_session_resolve "$SMODE" "$HC_REPO_ROOT")"
  SMODE="$(basename "$sfile" .json)"   # subsequent turns in a REPL reuse this session
  if hc_loop_run "$1" "$sfile"; then
    hc_session_set_title "$sfile" "$1"
    printf '%s\n' "$HC_LOOP_ANSWER"
  else
    printf '%s\n' "$HC_LOOP_ANSWER"; return 1
  fi
}

# one-shot / stdin: plain output, scriptable
if (( STDIN )); then run_turn "$(cat)"; exit $?; fi
if [[ -n "$ONESHOT" ]]; then run_turn "$ONESHOT"; exit $?; fi

# --- REPL ---
hc_api_check >/dev/null 2>&1 || {
  [[ -r "${HERMES_HANDS_SECRETS:-${XDG_CONFIG_HOME:-$HOME/.config}/hermes-hands/secrets}" ]] \
    && hc_die "API preflight failed - run: hermes-hands check" \
    || hc_die "not configured yet - run: hermes-hands setup"
}
{
  printf '\033[1mhermes-hands\033[0m %s  \342\200\224  %s\n' "$HC_VERSION" "$HC_REPO_ROOT"
  printf 'session %s   ·   /help  /new  /sessions  /check  /exit\n\n' "${SMODE#hc_}"
} >&2
while IFS= read -r -e -p $'\033[1myou\033[0m \342\200\272 ' line || { printf '\n'; break; }; do
  case "$line" in
    ""|" ")         continue ;;
    /exit|/quit|/q) break ;;
    /help)          printf '  send a message to converse. commands:\n    /new       start a fresh session in this dir\n    /sessions  list local sessions\n    /check     re-test the API\n    /exit      quit\n  one-shot:  hermes-hands "your question"\n\n' >&2; continue ;;
    /check)         hc_api_check >&2 || true; printf '\n' >&2; continue ;;
    /new)           SMODE=new; printf 'new session\n\n' >&2; continue ;;
    /sessions)      hc_session_list >&2; printf '\n' >&2; continue ;;
  esac
  history -s "$line" 2>/dev/null || true
  ans="$(run_turn "$line" || true)"
  printf '\n\033[1mhermes\033[0m \342\200\272 ' >&2
  printf '%s\n\n' "$ans" | hc_render
done
