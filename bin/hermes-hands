#!/usr/bin/env bash
# hermes-hands - terminal chat with a central Hermes brain over its Runs API.
# Hermes holds the plan/memory; it drives a persistent local shell plus
# read_file / write_file / edit_file to see and act on the repo you're in.
#
#   hermes-hands                    open a session in the current repo (main use)
#   hermes-hands -c                 resume this repo's last session
#   hermes-hands --session <id>     open a specific session
#   hermes-hands sessions           list local sessions
#   hermes-hands setup              interactive first-run config
#   hermes-hands check              preflight the API connection
#   hermes-hands --version          print version
#
#   hermes-hands "message"          one-shot (scripting); also: … | hermes-hands -
#   --new   force a fresh session      --yolo   skip run/write approvals
set -euo pipefail

# --- locate the checkout (for the lib/ + share/ files). In the single-file
#     build (build.sh) the libs are inlined and this block + the sources below
#     are dropped, between the two bundle markers. ---
# >>> bundle:drop
_self="${BASH_SOURCE[0]}"
while [[ -L "$_self" ]]; do
  _t="$(readlink "$_self")"; case "$_t" in /*) _self="$_t" ;; *) _self="$(dirname "$_self")/$_t" ;; esac
done
HH_ROOT="$(cd "$(dirname "$_self")/.." && pwd)"
export HH_ROOT

. "$HH_ROOT/lib/util.sh"
. "$HH_ROOT/lib/ui.sh"
. "$HH_ROOT/lib/session.sh"
. "$HH_ROOT/lib/api.sh"
. "$HH_ROOT/lib/dispatch.sh"
. "$HH_ROOT/lib/loop.sh"

HH_VERSION="$( { cat "$HH_ROOT/VERSION" 2>/dev/null || echo '0.0.0-dev'; } | tr -d '[:space:]')"
HH_BUILD_SHA="$( [[ -d "$HH_ROOT/.git" ]] && git -C "$HH_ROOT" rev-parse --short HEAD 2>/dev/null || echo '' )"
# <<< bundle:drop

usage() {
  cat <<'EOF'
hermes-hands - terminal chat with a central Hermes brain over its Runs API.
Hermes holds the plan/memory; it drives a persistent local shell plus
read_file / write_file / edit_file to see and act on the repo you're in.

  hermes-hands                    open a session in the current repo (main use)
  hermes-hands -c                 resume this repo's last session
  hermes-hands --session <id>     open a specific session
  hermes-hands sessions           list local sessions
  hermes-hands setup              interactive first-run config
  hermes-hands check              preflight the API connection
  hermes-hands --version          print version

  hermes-hands "message"          one-shot (scripting); also: … | hermes-hands -
  --new   force a fresh session      --yolo   skip run/write approvals
EOF
}

hh_version() { printf 'hermes-hands %s%s\n' "${HH_VERSION:-0.0.0-dev}" "${HH_BUILD_SHA:+ ($HH_BUILD_SHA)}"; }

# render a final answer: markdown-aware if a renderer is around and we're on a tty
hh_render() {
  if [[ -t 1 ]] && command -v glow >/dev/null 2>&1; then glow -w "${COLUMNS:-100}" -
  elif [[ -t 1 ]] && command -v bat  >/dev/null 2>&1; then bat -pp -l md --color=always
  else cat; fi
}

hh_setup() {
  local dir="${XDG_CONFIG_HOME:-$HOME/.config}/hermes-hands"
  mkdir -p "$dir"; chmod 700 "$dir"
  local url key
  read -r -p "Hermes API base URL (https://…): " url
  read -r -s -p "Hermes API_SERVER_KEY: " key; echo
  printf '# hermes-hands config\n# HERMES_API_PROFILE=coder   # optional /p/<profile>/ prefix\n# HERMES_HANDS_APPROVE=ask    # ask | auto | never\n' > "$dir/config"
  { printf '# hermes-hands secrets - chmod 600, do not commit\n'
    printf 'export HERMES_API_URL=%q\n' "$url"
    printf 'export HERMES_API_KEY=%q\n' "$key"; } > "$dir/secrets"
  chmod 600 "$dir/secrets"
  echo "wrote $dir/config and $dir/secrets"
  hh_load_config
  "$_self" check || true
  local line="[ -f \"\$HOME/.config/hermes-hands/secrets\" ] && . \"\$HOME/.config/hermes-hands/secrets\""
  if ! grep -qF "hermes-hands/secrets" "$HOME/.bashrc" 2>/dev/null; then
    read -r -p "Add the secrets-sourcing line to ~/.bashrc? [y/N] " a
    [[ "$a" == [yY] ]] && printf '\n# hermes-hands\n%s\n' "$line" >> "$HOME/.bashrc" && echo "added."
  fi
}

# --- arg parse ---
SMODE=new           # new | continue | <id>
ONESHOT=""
STDIN=0
while (( $# )); do
  case "$1" in
    -h|--help)         usage; exit 0 ;;
    -v|--version)      hh_version; exit 0 ;;
    version)           hh_version; exit 0 ;;
    check|--check)      hh_load_config; hh_api_check; exit $? ;;
    sessions|--list)    hh_session_list; exit 0 ;;
    setup)             hh_setup; exit 0 ;;
    -c|--continue)      SMODE=continue ;;
    --new)             SMODE=new ;;
    --session)         shift; SMODE="${1:?--session needs an id}" ;;
    --yolo)            export HERMES_HANDS_APPROVE=auto ;;
    -)                 STDIN=1 ;;
    --)                shift; ONESHOT="$*"; break ;;
    -*)                hh_die "unknown option: $1" ;;
    *)                 ONESHOT="${ONESHOT:+$ONESHOT }$1" ;;
  esac
  shift || true
done

hh_load_config
HH_REPO_ROOT="$(pwd -P)"; export HH_REPO_ROOT
trap 'hh_shell_stop 2>/dev/null || true' EXIT

run_turn() {   # $1 = message ; prints the answer
  local sfile; sfile="$(hh_session_resolve "$SMODE" "$HH_REPO_ROOT")"
  SMODE="$(basename "$sfile" .json)"   # subsequent turns in a REPL reuse this session
  if hh_loop_run "$1" "$sfile"; then
    hh_session_set_title "$sfile" "$1"
    printf '%s\n' "$HH_LOOP_ANSWER"
  else
    printf '%s\n' "$HH_LOOP_ANSWER"; return 1
  fi
}

# one-shot / stdin: plain output, scriptable (no framing, for pipes & CI)
if (( STDIN )); then run_turn "$(cat)"; exit $?; fi
if [[ -n "$ONESHOT" ]]; then run_turn "$ONESHOT"; exit $?; fi

# --- interactive session ---
hh_api_check >/dev/null 2>&1 || {
  [[ -r "${HERMES_HANDS_SECRETS:-${XDG_CONFIG_HOME:-$HOME/.config}/hermes-hands/secrets}" ]] \
    && hh_die "API preflight failed - run: hermes-hands check" \
    || hh_die "not configured yet - run: hermes-hands setup"
}
# resolve the session once up front so the header shows its id
_sf="$(hh_session_resolve "$SMODE" "$HH_REPO_ROOT")"; SMODE="$(basename "$_sf" .json)"
{
  printf '%s%shermes-hands%s %s%s  %s\xc2\xb7%s  %s\n' "$UI_B" "$UI_HERMES" "$UI_R" "$UI_DIM" "$HH_VERSION" "$UI_DIM" "$UI_R" "$HH_REPO_ROOT"
  printf '%ssession %s  \xc2\xb7  /help  /new  /sessions  /exit%s\n\n' "$UI_DIM" "${SMODE#hh_}" "$UI_R"
} >&2

_help() { {
  printf '%s  type a message to talk to Hermes; it drives shell/read/write here.\n' "$UI_DIM"
  printf '    /new       fresh session in this directory\n'
  printf '    /sessions  list local sessions\n'
  printf '    /check     re-test the API\n'
  printf '    /exit      quit  (Ctrl-D also)\n'
  printf '  one-shot for scripts:  hermes-hands "question"%s\n' "$UI_R"
} >&2; }

while IFS= read -r -e -p "$(printf '%s%syou%s \xe2\x9d\xaf ' "$UI_B" "$UI_YOU" "$UI_R")" line || { printf '\n'; break; }; do
  case "$line" in
    ""|" ")         continue ;;
    /exit|/quit|/q) break ;;
    /help|/h|/\?)   _help; printf '\n' >&2; continue ;;
    /check)         hh_api_check >&2 || true; printf '\n' >&2; continue ;;
    /new)           SMODE=new; _sf="$(hh_session_resolve new "$HH_REPO_ROOT")"; SMODE="$(basename "$_sf" .json)"
                    printf '%s— new session %s —%s\n\n' "$UI_DIM" "${SMODE#hh_}" "$UI_R" >&2; continue ;;
    /sessions)      hh_session_list >&2; printf '\n' >&2; continue ;;
  esac
  history -s "$line" 2>/dev/null || true
  printf "\n" >&2; ui_rule
  ui_you "$line"
  ui_working
  if hh_loop_run "$line" "$_sf"; then hh_session_set_title "$_sf" "$line"; fi
  printf '\n' >&2
  ui_answer "$HH_LOOP_ANSWER"
  printf '\n' >&2
done
